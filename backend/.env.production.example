# ==========================================================
# Sentinel Backend — PRODUCTION environment template.
# Copy to `.env`, fill in real values, and never commit the result.
# ==========================================================

APP_NAME="Sentinel AI Workplace Safety Platform"
APP_ENV=production
API_V1_PREFIX=/api
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Point at a real database in production — SQLite is fine for a single-node
# demo/pilot deployment but has no concurrent-write story at scale.
#   postgresql+psycopg2://sentinel:PASSWORD@db-host:5432/sentinel
DATABASE_URL=sqlite:////app/data/sentinel.db

# Comma-separated list of your actual deployed frontend origin(s) — no
# wildcards, no localhost, in production.
CORS_ORIGINS=https://safety.yourcompany.com

UPLOAD_DIR=uploads
REPORTS_DIR=reports
LOG_DIR=logs
MAX_UPLOAD_SIZE_MB=50

MODEL_DIR=models
MODEL_FILENAME=best.pt
MODEL_DEVICE=AUTO
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.bmp

# CHANGE the demo admin password before going live — this account is
# seeded automatically on first startup.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@yourcompany.com
DEMO_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
