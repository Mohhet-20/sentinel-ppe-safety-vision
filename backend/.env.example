# ==========================================================
# Sentinel Backend — Environment Configuration (example)
# Copy this file to `.env` and adjust values for your setup.
# ==========================================================

# --- App ---
APP_NAME="Sentinel AI Workplace Safety Platform"
APP_ENV=development
API_V1_PREFIX=/api
DEBUG=true

# --- Security / JWT ---
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# SQLite by default for local development. Point this at Postgres/MySQL in production,
# e.g. postgresql+psycopg2://user:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# --- CORS ---
# Comma-separated list of allowed origins for the frontend dev server / deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
UPLOAD_DIR=uploads
REPORTS_DIR=reports
LOG_DIR=logs
MAX_UPLOAD_SIZE_MB=50

# --- AI model ---
# Drop a fine-tuned YOLO11s checkpoint at backend/models/best.pt (default
# MODEL_DIR/MODEL_FILENAME below) — the inference service auto-detects and
# hot-reloads it, no restart needed.
MODEL_DIR=models
MODEL_FILENAME=best.pt
MODEL_DEVICE=AUTO
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.bmp

# --- Demo admin user (seeded on first startup) ---
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@sentinel-ai.com
DEMO_ADMIN_PASSWORD=ChangeMe123!
